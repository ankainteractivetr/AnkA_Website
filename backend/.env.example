# ----------------------------------------------------------------------------
# AnkA Backend Environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ----------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5000

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://ankainteractive.com,https://www.ankainteractive.com

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anka

# Admin credentials — backend re-hashes on every boot, so just edit & restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ankaadmin2026

# JWT secret (any long random string)
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Contact form SMTP (replaces ulak.js hard-coded credentials)
SMTP_HOST=mail.ankainteractive.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@ankainteractive.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@ankainteractive.com
SMTP_TO=contact@ankainteractive.com

# Uploads
MAX_UPLOAD_SIZE_MB=10
