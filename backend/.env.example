# ----------------------------------------------------------------------------
# AnkA Backend Environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ----------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# CORS — comma separated list of allowed frontend origins (empty: every origin)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://ankainteractive.com,https://www.ankainteractive.com

# Optional: the built frontend (relative to backend/) when this API should serve the site itself, e.g. ../frontend/dist
FRONTEND_DIR=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=anka_website

# CMS account — re-created from these on every start, so just edit & restart. ADMIN_PASSWORD is required.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# JWT secret (any long random string) and session length
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Contact form e-mails (without SMTP_HOST / SMTP_USER they are only logged)
SMTP_HOST=mail.ankainteractive.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@ankainteractive.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@ankainteractive.com
SMTP_TO=contact@ankainteractive.com

# Uploads
MAX_UPLOAD_SIZE_MB=10

# Thumbnails (optional): longest edge in px, and JPEG quality
THUMB_MAX_PX=480
THUMB_JPEG_QUALITY=82
