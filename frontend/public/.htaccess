# ============================================================================
#  AnkA Interactive — public_html/.htaccess
#  For the built Vite/React frontend (the contents of frontend/dist/).
#  Placed in frontend/public/ so Vite auto-copies it into dist/ on build.
# ============================================================================

# UTF-8 by default
AddDefaultCharset UTF-8

# Don't expose a directory file listing
Options -Indexes

# ----------------------------------------------------------------------------
#  Rewrites: HTTPS redirect + Single-Page-App fallback
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Force HTTPS (http -> https) ---
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- (OPTIONAL) Force a single canonical host. Uncomment ONE block. ---
    # www -> non-www
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
    #
    # non-www -> www
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- SPA fallback ---
    # If the request maps to a real file or directory, serve it as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # If you EVER reverse-proxy the Node API through this same domain, keep
    # /api requests out of the SPA fallback (harmless to leave in otherwise).
    RewriteRule ^api/ - [L]

    # Everything else -> index.html so React Router can take over the route.
    RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------------
#  Compression (smaller, faster transfers)
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/font-woff
</IfModule>

# ----------------------------------------------------------------------------
#  Caching
#  Vite emits hashed filenames under /assets/ (e.g. index-a1b2c3.js), so those
#  can be cached forever. index.html must NOT be cached, or users keep seeing
#  the old app after you deploy a new build.
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Hashed build assets — safe to cache for a year
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images from /public (no content hash) — moderate cache so swaps show up
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico)$">
        ExpiresDefault "access plus 7 days"
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # The app shell — always revalidate so new deploys appear immediately
    <FilesMatch "\.(html)$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
#  Security headers (sensible defaults)
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Stop browsers from MIME-sniffing the content type
    Header set X-Content-Type-Options "nosniff"

    # Disallow OTHER sites from framing yours (your own iframes to Steam/Maps
    # are unaffected — this only controls who may embed THIS site).
    Header always set X-Frame-Options "SAMEORIGIN"

    # Send only the origin on cross-site navigations
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Limit powerful browser features by default
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # (OPTIONAL) HSTS — only enable once you're sure HTTPS always works,
    # otherwise it can lock users out of the http version for a year.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ----------------------------------------------------------------------------
#  Custom error fallback (SPA also handles unknown routes, this is a backstop)
# ----------------------------------------------------------------------------
ErrorDocument 404 /index.html
