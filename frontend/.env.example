# API base URL. Leave empty in development: Vite proxies /api and /uploads to the backend (API_PROXY_TARGET),
# so the site and the API share one origin and the httpOnly CMS cookie just works.
# Production builds (put these in .env.production), e.g.:
#   VITE_API_URL=https://www.ankainteractive.com/api
#   VITE_BACKEND_URL=https://api.ankainteractive.com
VITE_API_URL=

# Where uploaded images (/uploads/...) are served from; empty means the site's own origin.
VITE_BACKEND_URL=

# Development only: the backend the Vite dev server proxies /api and /uploads to.
API_PROXY_TARGET=http://localhost:5000
